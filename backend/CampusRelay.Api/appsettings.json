{
  "Database": {
    "Provider": "Sqlite",
    "AutoMigrate": false
  },
  "ConnectionStrings": {
    "Campus": "Data Source=campusrelay.db"
  },
  "Firebase": {
    "ProjectId": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Notifications": {
    "EnableFcm": false,
    "FirebaseProjectId": "",
    "PollSeconds": 15,
    "MaxAttempts": 8
  }
}
